{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ezSPclient",
  "version": "0.1.0",
  "identifier": "top.rakkasei.ezspclient",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ezSPclient · 卫戍协议",
        "width": 1080,
        "height": 720,
        "minWidth": 860,
        "minHeight": 580,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Game",
    "shortDescription": "卫戍协议：盟约 多平台客户端",
    "longDescription": "多服务器地址簿、探活与全屏游戏窗口的轻量客户端（《卫戍协议：盟约》网页版外壳）",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
