# 依赖与构建产物
node_modules/
/src-tauri/target/
/src-tauri/gen/

# 签名材料：绝不能入库
*.jks
*.keystore
keystore.properties
*.pepk

# 凭据与环境（本仓库用不到，纯属防手滑）
.env
.env.*
!.env.example
credentials*.json
service[_-]account*.json
*.p12
*.pfx
*.pem
*.key
*.mobileprovision

# 前端/打包输出
dist/
*.msi
*.nsis
*.dmg
*.AppImage
*.deb
*.apk
*.aab

# 本地运行期数据（配置默认在系统用户目录，这里只防手滑放进仓库）
*.local.json
logs/
*.log

# 编辑器与系统
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.DS_Store
Thumbs.db
desktop.ini

# 暂存与临时
.tmp/
tmp/
*.rs.bk
*.pdb
__pycache__/
*.pyc
